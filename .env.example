# ==============================================================================
# PDF AI Assistant Service Environment Variables Blueprint
# Copy this blueprint to .env and configure secret keys prior to deploy.
# ==============================================================================

# --- LLM API Keys & Model configuration ---
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=
MODEL_NAME=gemini-2.5-flash

# --- System Target Mode ---
ENVIRONMENT=development
PROJECT_NAME="PDF AI Assistant Service"
API_V1_STR=/api/v1
SECRET_KEY=generate_a_secure_random_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Firebase & Firestore Authentication ---
# Option A: Path to the downloaded service account JSON (recommended for local dev)
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Place the file at: backend/firebase_service_account.json (this file is gitignored)
FIREBASE_PROJECT_ID=pdf-app-48c12
FIREBASE_CREDENTIALS_PATH=./firebase_service_account.json
FIRESTORE_COLLECTION_BOOKS=books

# --- Vector Database & Storage ---
CHROMA_DB_PATH=./chroma_db
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RATE_LIMIT_PER_MINUTE=20
LLM_TIMEOUT_SECONDS=15
MAX_CONTEXT_TOKENS=8000
UPLOAD_DIR=/app/storage/uploads
MAX_FILE_SIZE_MB=50
