# ==============================================================================
# PDF AI Assistant Service Environment Variables Blueprint
# Copy this blueprint to .env and configure secret keys prior to deploy.
# ==============================================================================

# --- System Target Mode ---
ENVIRONMENT=development
PROJECT_NAME="PDF AI Assistant Service"
API_V1_STR=/api/v1
SECRET_KEY=9a2b8e3c4d5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Postgres Server Connections ---
POSTGRES_SERVER=db
POSTGRES_USER=postgres_master
POSTGRES_PASSWORD=secure_postgres_pass_2026
POSTGRES_DB=pdf_app_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres_master:secure_postgres_pass_2026@db:5432/pdf_app_dev

# --- Redis & Task Brokering ---
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://cache:6379/1
CELERY_RESULT_BACKEND=redis://cache:6379/2

# --- Specialized Indexes ---
CHROMADB_HOST=vector_db
CHROMADB_PORT=8000

# --- Local Inference Configurations ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=mistral:7b-instruct-v0.2
EMBEDDINGS_MODEL=all-MiniLM-L6-v2

# --- External Pipelines Binds ---
LIBRETRANSLATE_URL=http://translation:5000
SPACY_MODEL=en_core_web_md

# --- Storage Settings ---
UPLOAD_DIR=/app/storage/uploads
MAX_FILE_SIZE_MB=50
