# ==============================================================================
# Mobile App Environment Configuration (.env)
# ==============================================================================

# Backend API Base URL
# - Android Emulator: http://10.0.2.2:8000/api/v1
# - Physical Device on local Wi-Fi: http://<YOUR_PC_LOCAL_IP>:8000/api/v1 (e.g. http://192.168.1.50:8000/api/v1)
# - Production API: https://api.yourdomain.com/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1

# Firebase Client Configuration (Used for Web / JS SDK fallback and custom configs)
# Note: For Android native builds, download google-services.json from Firebase Console
# and place it at mobile/google-services.json (this file is gitignored).
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=pdf-app-48c12.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=pdf-app-48c12
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=pdf-app-48c12.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=830804213374
EXPO_PUBLIC_FIREBASE_APP_ID=1:830804213374:android:49c2867b494b71f984222f
