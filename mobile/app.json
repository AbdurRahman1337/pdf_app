{
  "expo": {
    "name": "PDF INSIGHTS",
    "slug": "pdf-insights",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.technext.pdf_app"
    },
    "android": {
      "package": "com.technext.pdf_app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#020617"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ],
    "owner": "abdurrahman1337-2",
    "extra": {
      "eas": {
        "projectId": "caa611df-feee-4be0-bd51-34b7ed6ef308"
      }
    }
  }
}
