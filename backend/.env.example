# ==============================================================================
# Backend Environment Configuration (.env)
# ==============================================================================

# LLM API Keys & Model configuration
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=
MODEL_NAME=gemini-2.5-flash

# Vector Database configuration
CHROMA_DB_PATH=./chroma_db

# Chunking parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Operational parameters
RATE_LIMIT_PER_MINUTE=20
LLM_TIMEOUT_SECONDS=15
MAX_CONTEXT_TOKENS=8000

# Firebase & Firestore Database configuration
FIREBASE_PROJECT_ID=pdf-app-48c12
FIREBASE_CREDENTIALS_PATH=./firebase_service_account.json
FIRESTORE_COLLECTION_BOOKS=books

# Google Drive Storage & Google Cloud configuration
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_DRIVE_FOLDER_NAME=AI Study Assistant
GOOGLE_CLIENT_ID=your_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_oauth_client_secret_here
GOOGLE_CLIENT_SECRET_PATH=./google_client_secret.json

